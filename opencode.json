{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "idalib-cli *": "allow",
      "idalib-cli parallel *": "allow",
      "ls *": "allow",
      "file *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "xxd *": "allow",
      "strings *": "allow",
      "otool *": "allow",
      "nm *": "allow",
      "codesign *": "allow",
      "python3 samples/*": "allow",
      "clang samples/*": "allow",
      "gcc samples/*": "allow",
      "python3 reports/poc/*": "allow",
      "python3 -c *": "ask",
      "mkdir *": "allow",
      "rg *": "allow",
      "jq *": "allow",
      "*": "ask"
    },
    "external_directory": {
      "~/Documents/reverse/**": "allow",
      "*": "ask"
    }
  }
}
